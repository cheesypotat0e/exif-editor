{
  "name": "exif-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:software": "node scripts/fetch-software-versions.mjs",
    "fetch:software": "node scripts/fetch-software-versions.mjs",
    "build": "node scripts/fetch-software-versions.mjs && tsc && node scripts/build.mjs",
    "build:cli": "pnpm --filter exif-editor-cli build",
    "cli": "node packages/exif-editor-cli/dist/cli.js",
    "preview": "vite preview",
    "pretest": "node src/__tests__/fixtures/generate-fixtures.ts",
    "coverage": "jest --coverage",
    "test": "jest",
    "test:cli": "pnpm --filter exif-editor-cli test"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide": "^1.35.0"
  }
}
